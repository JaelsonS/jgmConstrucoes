# Server-only email settings. Never prefix secrets with VITE_.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
CONTACT_RECIPIENT=
RECRUITMENT_RECIPIENT=

# Optional anti-bot verification. Leave empty until configured.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Public canonical origin (use the Vercel URL on preview, domain final em produção)
# Exemplo preview: https://jgm-construcoes.vercel.app
VITE_SITE_URL=https://jgmconstrucoes.com
